---
import AdminLabelFields from "../../components/AdminLabelFields.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import EditorTabs from "../../components/EditorTabs.astro";
import { getContentLabels } from "../../lib/label-repository";
import { getPublishBatch } from "../../lib/publisher-repository";
import { getSiteSettings, getSocialLinks, socialPlatformLabels } from "../../lib/site-repository";
import { getAdminVideos } from "../../lib/video-repository";
import { providerLabels } from "../../lib/video";
import { socialPlatforms, type SocialPlatform } from "../../types/publisher";
import "../../styles/global.css";
import "../../styles/admin.css";

const settings = await getSiteSettings(Astro.locals);
const socials = await getSocialLinks(Astro.locals);
const videos = await getAdminVideos(Astro.locals);
const labels = await getContentLabels(Astro.locals);
const saved = Astro.url.searchParams.get("saved");
const error = Astro.url.searchParams.get("error");
const initialTab = ['video', 'status'].includes(saved || error || '') || Astro.url.searchParams.has('publisherBatch') ? 'website-videos' : 'website-settings';
const publisherBatchId = Astro.url.searchParams.get("publisherBatch");
const publisherPlatformValue = Astro.url.searchParams.get("publisherPlatform");
const publisherBatch = publisherBatchId && /^[0-9a-f-]{36}$/i.test(publisherBatchId) ? await getPublishBatch(Astro.locals, publisherBatchId) : undefined;
const publisherPlatform = socialPlatforms.includes(publisherPlatformValue as SocialPlatform) ? publisherPlatformValue as SocialPlatform : undefined;
const publisherTarget = publisherBatch?.targets.find((target) => target.platform === publisherPlatform && target.status === "published" && target.publishedUrl);
const publisherPrefill = publisherBatch && publisherTarget ? {
  sourceUrl: publisherTarget.publishedUrl ?? "",
  titleEn: publisherBatch.youtubeTitle ?? "",
  descriptionEn: publisherTarget.platform === "youtube" ? publisherBatch.youtubeDescription || publisherBatch.sharedText : publisherBatch.sharedText,
} : undefined;
const today = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Asia/Kolkata",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#082f78" />
    <title>Website editor | Naee Parvaz News</title>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-content">Skip to editor</a>
    <AdminHeader kicker="Editor workspace" title={initialTab === 'website-videos' ? 'Website videos' : 'Website settings'} description="Manage your website details and video library. Save each section when you finish editing." />

    <main id="admin-content" class="admin-container admin-main">
      {saved && <p class="admin-notice admin-notice-success" role="status">Changes saved successfully.</p>}
      {error && <p class="admin-notice admin-notice-error" role="alert">The update could not be saved. Check the fields and try again. If this continues, contact your website administrator.</p>}
      {publisherPrefill && <p class="admin-notice admin-notice-success" role="status">The published social link and available copy are prefilled below. Add bilingual editorial details, review the labels, then save one website-library draft.</p>}

      <div data-editor-tabs>
      <EditorTabs label="Website sections" defaultTab={initialTab} tabs={[{id:'website-settings',label:'Website settings'},{id:'website-videos',label:'Website videos'}]}/>
      <div id="website-settings">
      <section class="admin-section" aria-labelledby="contact-settings-heading">
        <div class="admin-section-heading">
          <div><p class="kicker">Contact details</p><h2 id="contact-settings-heading">Editor and newsroom</h2></div>
          <p>These details appear across the website and decide where contact emails are sent.</p>
        </div>
        <form class="admin-form" method="post" action="/api/editor/settings/">
          <input type="hidden" name="section" value="contact" />
          <div class="admin-form-grid">
            <label>Editor name<input name="editorName" required minlength="2" maxlength="100" value={settings.editorName} /></label>
            <label>Editorial email<input name="email" required type="email" maxlength="254" value={settings.email} /></label>
            <label>English role<input name="editorTitleEn" required minlength="3" maxlength="160" value={settings.editorTitleEn} /></label>
            <label>Hindi role<input name="editorTitleHi" required minlength="3" maxlength="160" value={settings.editorTitleHi} lang="hi" /></label>
            <label>Phone number<input name="phoneDisplay" required minlength="8" maxlength="30" value={settings.phoneDisplay} /></label>
          </div>
          <button class="button" type="submit">Save contact details</button>
        </form>
      </section>

      <section class="admin-section" aria-labelledby="social-settings-heading">
        <div class="admin-section-heading">
          <div><p class="kicker">Social accounts</p><h2 id="social-settings-heading">Profiles and links</h2></div>
          <p>You can show an account name without a link. Links must use https:// and belong to the selected social website.</p>
        </div>
        <form class="admin-form" method="post" action="/api/editor/settings/">
          <input type="hidden" name="section" value="social" />
          <div class="admin-social-list">
            {socials.map((social) => (
              <fieldset>
                <legend>{socialPlatformLabels[social.platform]}</legend>
                <label>
                  Account name
                  <input name={`${social.platform}Identity`} required maxlength="100" value={social.identity} />
                </label>
                <label>
                  Profile link (optional)
                  <input name={`${social.platform}Url`} type="url" inputmode="url" maxlength="500" value={social.url ?? ""} placeholder="https://…" />
                </label>
                <label class="admin-check"><input name={`${social.platform}Enabled`} type="checkbox" checked={social.enabled} /> Show on website</label>
              </fieldset>
            ))}
          </div>
          <button class="button" type="submit">Save social profiles</button>
        </form>
      </section>

      </div>
      <div id="website-videos">
      <section class="admin-section" id="new-video" aria-labelledby="new-video-heading">
        <div class="admin-section-heading">
          <div><p class="kicker">Video desk</p><h2 id="new-video-heading">Add a video</h2></div>
          <p>Paste a public YouTube, Instagram or Facebook video link. This adds its link and description, not a copy of the video.</p>
        </div>
        <form class="admin-form" method="post" action="/api/editor/videos/">
          <div class="admin-form-grid">
            <label class="admin-span-2">Public video URL<input name="sourceUrl" required type="url" inputmode="url" maxlength="1000" value={publisherPrefill?.sourceUrl ?? ""} placeholder="https://www.youtube.com/watch?v=…" /></label>
            <label>Published date<input name="publishedAt" required type="date" value={today} /></label>
            <label class="admin-span-2">Google Drive thumbnail (optional)<input name="thumbnailUrl" type="url" inputmode="url" maxlength="1000" placeholder="https://drive.google.com/file/d/…/view" /></label>
            <AdminLabelFields labels={labels} selected={["other"]} />
            <label>English title<input name="titleEn" maxlength="240" value={publisherPrefill?.titleEn ?? ""} /></label>
            <label lang="hi">हिंदी शीर्षक<input name="titleHi" maxlength="240" lang="hi" /></label>
            <label>English description<textarea name="descriptionEn" maxlength="1200" rows="4">{publisherPrefill?.descriptionEn ?? ""}</textarea></label>
            <label lang="hi">हिंदी विवरण<textarea name="descriptionHi" maxlength="1200" rows="4" lang="hi"></textarea></label>
            <label>Status<select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label>
            <label class="admin-check admin-check-bottom"><input name="featured" type="checkbox" /> Feature this video</label>
          </div>
          <p class="admin-help">Enter at least one title. If a translation is missing, visitors will see the title in the available language.</p>
          <button class="button" type="submit">Add video</button>
        </form>
      </section>

      <section class="admin-section" aria-labelledby="video-library-heading">
        <div class="admin-section-heading">
          <div><p class="kicker">Library</p><h2 id="video-library-heading">Manage videos</h2></div>
          <p>{videos.length} {videos.length === 1 ? "record" : "records"}. Drafts never appear on the public website.</p>
        </div>
        {videos.length ? (
          <div class="admin-video-list">
            {videos.map((video) => (
              <article class="admin-video-record">
                <div class="admin-record-header">
                  <div>
                    <span class:list={["admin-status", `admin-status-${video.status}`]}>{video.status}</span>
                    <strong>{providerLabels[video.provider]}</strong>
                    {video.featured && <span class="admin-featured">Featured</span>}
                    {!video.translations.en && <span class="admin-translation-warning">English title missing</span>}
                    {!video.translations.hi && <span class="admin-translation-warning">Hindi title missing</span>}
                  </div>
                  <a href={video.canonicalUrl} target="_blank" rel="noopener">Open original ↗</a>
                </div>
                <form class="admin-form" method="post" action="/api/editor/videos/">
                  <input type="hidden" name="id" value={video.id} />
                  <div class="admin-form-grid">
                    <label class="admin-span-2">Public video URL<input name="sourceUrl" required type="url" maxlength="1000" value={video.sourceUrl} /></label>
                    <label>Published date<input name="publishedAt" required type="date" value={video.publishedAt.slice(0, 10)} /></label>
                    <label class="admin-span-2">Google Drive thumbnail (optional)<input name="thumbnailUrl" type="url" inputmode="url" maxlength="1000" value={video.thumbnailSourceUrl ?? ""} /></label>
                    <AdminLabelFields labels={labels} selected={video.labels.map((label) => label.id)} />
                    <label>English title<input name="titleEn" maxlength="240" value={video.translations.en?.title ?? ""} /></label>
                    <label lang="hi">हिंदी शीर्षक<input name="titleHi" maxlength="240" value={video.translations.hi?.title ?? ""} lang="hi" /></label>
                    <label>English description<textarea name="descriptionEn" maxlength="1200" rows="4">{video.translations.en?.description ?? ""}</textarea></label>
                    <label lang="hi">हिंदी विवरण<textarea name="descriptionHi" maxlength="1200" rows="4" lang="hi">{video.translations.hi?.description ?? ""}</textarea></label>
                    <label>Status<select name="status"><option value="draft" selected={video.status === "draft"}>Draft</option><option value="published" selected={video.status === "published"}>Published</option></select></label>
                    <label class="admin-check admin-check-bottom"><input name="featured" type="checkbox" checked={video.featured} /> Feature this video</label>
                  </div>
                  <div class="admin-actions">
                    <button class="button" type="submit">Save changes</button>
                  </div>
                </form>
                <form method="post" action="/api/editor/video-status/">
                  <input type="hidden" name="id" value={video.id} />
                  <input type="hidden" name="status" value={video.status === "published" ? "draft" : "published"} />
                  <button class="button button-outline" type="submit">{video.status === "published" ? "Unpublish" : "Publish"}</button>
                </form>
              </article>
            ))}
          </div>
        ) : (
          <p class="admin-empty">No video records yet. Add the first link above as a draft, review it, then publish it.</p>
        )}
      </section>
      </div>
      </div>
    </main>
  </body>
</html>
