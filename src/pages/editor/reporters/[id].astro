---
import EditorLayout from '../../../layouts/EditorLayout.astro';
import { application, applicationFiles, database, type Card } from '../../../lib/reporters';
import { reporterNumber, indiaToday } from '../../../lib/reporter-card';
import { policyAcceptances } from '../../../lib/reporter-policy';
const app=await application(Astro.params.id || ''); if(!app) return new Response('Not found',{status:404});
const files=await applicationFiles(app.id);
const acceptances=await policyAcceptances(app.id);
const events=(await database().query('SELECT actor,action,note,created_at FROM reporter_events WHERE application_id=$1 ORDER BY created_at DESC',[app.id])).rows;
const emails=(await database().query('SELECT id,kind,status,created_at FROM reporter_emails WHERE application_id=$1 ORDER BY created_at DESC',[app.id])).rows;
const card=(await database().query('SELECT * FROM reporter_cards WHERE application_id=$1',[app.id])).rows[0] as Card|undefined;
const cardStatus=card?.revoked_at ? 'REVOKED' : card && new Date(card.expires_on).getTime()+86400000 < Date.now() ? 'Expired' : 'Valid';
const previewId=Astro.url.searchParams.get('preview');
const preview=previewId && /^[0-9a-f-]{36}$/i.test(previewId) ? (await database().query('SELECT id,input FROM reporter_previews WHERE id=$1 AND application_id=$2 AND expires_at>now()',[previewId,app.id])).rows[0] : undefined;
const editable=!app.purged_at && !['approved','rejected'].includes(app.status);
const fields:Record<string,string>={name:'Name',email:'Email',phone:'Phone',address:'Address',area:'Reporting area',languages:'Languages',education:'Education',experience:'Experience',identityType:'Identity proof',transaction:'Transaction reference',paymentDate:'Payment date',workSamples:'Work samples'};
---
<EditorLayout title={app.purged_at?'Removed reporter profile':app.profile.name} description={`Application ${app.id}`}>
<a href="/editor/reporters/">← All applications</a>{Astro.url.searchParams.has('error') && <p role="alert">{Astro.url.searchParams.get('error')}</p>}{Astro.url.searchParams.has('saved') && <p role="status">Changes saved.</p>}
<section class="admin-section"><h2>Application — {app.status}</h2><p>Payment: {app.payment_verified?'Verified by editor':'Not verified'}</p><dl class="reporter-details">{Object.entries(app.profile).map(([key,value]) => <div><dt>{fields[key] || key}</dt><dd>{value || '—'}</dd></div>)}</dl><h3>Payment terms at submission</h3><p>₹{app.payment_terms.fee} — {app.payment_terms.payee}</p><p>{app.payment_terms.instructionsEn}</p><p>{app.payment_terms.refundEn}</p><p lang="hi">{app.payment_terms.refundHi}</p><h3>Private attachments</h3><ul>{files.map((file) => <li><a href={`/api/editor/reporters/file/?id=${file.id}&download=1`}>{file.kind} ({Math.ceil(file.byte_size/1024)} KB)</a></li>)}</ul></section>
{editable && <section class="admin-section"><h2>Review actions</h2><form class="admin-form" method="post" action="/api/editor/reporters/action/"><input type="hidden" name="id" value={app.id}/><label>Action<select name="action"><option value="under-review">Mark under review</option><option value="verify-payment">Verify actual payment and mark under review</option><option value="changes-requested">Request corrections by email</option><option value="reject">Reject application</option></select></label><label>Reason / message to applicant<textarea name="note" maxlength="2000" rows="4"></textarea></label><label><input type="checkbox" name="confirm" value="yes"/> I confirm this decision. For payment verification I checked the actual transaction, not just the screenshot.</label><button class="button">Save review decision</button></form></section>}
{editable && <section class="admin-section"><h2>Prepare ID preview</h2><p>Complete payment verification first, then preview. Name comes from the applicant’s reviewed details.</p><form class="admin-form" method="post" action="/api/editor/reporters/action/"><input type="hidden" name="id" value={app.id}/><input type="hidden" name="action" value="preview"/><div class="admin-form-grid"><label>Designation<input name="designation" required maxlength="60" value={preview?.input.designation || 'REPORTER'}/></label><label>Joining date<input type="date" name="joined" required value={preview?.input.joined || indiaToday()}/></label><label>Photo horizontal crop (%)<input name="cropX" type="range" min="0" max="100" value={preview?.input.cropX ?? 50}/></label><label>Photo vertical crop (%)<input name="cropY" type="range" min="0" max="100" value={preview?.input.cropY ?? 50}/></label><label>Photo zoom<input name="zoom" type="number" min="1" max="3" step="0.1" value={preview?.input.zoom ?? 1}/></label></div><button class="button">Generate / refresh preview</button></form>
{preview && <><img src={`/api/editor/reporters/file/?kind=preview&id=${preview.id}`} alt="Candidate ID preview" width="454" height="640" class="id-preview"/><form class="admin-form" method="post" action="/api/editor/reporters/action/"><input type="hidden" name="action" value="approve"/><input type="hidden" name="id" value={app.id}/><input type="hidden" name="preview" value={preview.id}/><label><input type="checkbox" name="confirm" value="yes" required/> I checked the photo, name, designation, number, dates and design. Issue this ID and email the candidate.</label><button class="button" disabled={!app.payment_verified || app.status!=='under-review'}>Approve and issue ID</button></form></>}
</section>}
{card && <section class="admin-section"><h2>Issued card — {reporterNumber(Number(card.number))}</h2><p>{cardStatus} · {card.designation}</p><p>Joined: {new Date(card.joined_on).toLocaleDateString('en-IN')} · Expires: {new Date(card.expires_on).toLocaleDateString('en-IN')}</p>{!card.deleted_at && <><img class="id-preview" src={`/api/editor/reporters/file/?kind=card-image&id=${card.id}`} alt="Issued reporter ID" width="454" height="640"/><p><a href={`/api/editor/reporters/file/?kind=card-pdf&id=${card.id}`}>Download PDF</a> · <a href={`/api/editor/reporters/file/?kind=card-image&id=${card.id}&download=1`}>Download image</a></p></>}{!card.revoked_at && !app.purged_at && <form method="post" class="admin-form" action="/api/editor/reporters/action/"><input type="hidden" name="action" value="revoke"/><input type="hidden" name="id" value={app.id}/><label>Revocation reason<textarea name="note" required maxlength="2000"></textarea></label><label><input type="checkbox" name="confirm" value="yes" required/> Confirm revocation and notification</label><button class="button button-outline">Revoke ID</button></form>}</section>}
<section class="admin-section"><h2>Email delivery</h2>{emails.map((email) => <div><p>{email.kind}: {email.status}</p>{email.status==='failed' && !app.purged_at && <form method="post" action="/api/editor/reporters/action/"><input type="hidden" name="action" value="retry-email"/><input type="hidden" name="id" value={app.id}/><input type="hidden" name="emailId" value={email.id}/><button class="button button-outline">Retry confirmed failure</button></form>}{email.status==='unknown' && <p>Delivery outcome is unknown. Check the email provider before taking further action; no automatic resend.</p>}</div>)}</section>
<section class="admin-section"><h2>Review history</h2><ul>{events.map((e) => <li>{new Date(e.created_at).toLocaleString('en-IN')} · {e.action} · {e.actor}<p>{e.note}</p></li>)}</ul></section>
<section class="admin-section"><h2>Reporter policy acceptance</h2>
{app.purged_at?<p>Personal acceptance records removed under the profile-retention policy.</p>:acceptances.length?acceptances.map(acceptance=><details><summary>Version {acceptance.policy_version_id} — {new Date(acceptance.accepted_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'})} IST — {acceptance.locale==='hi'?'Hindi':'English'}</summary>
<p>Applicant at acceptance: {acceptance.applicant_name}</p>
<div lang={acceptance.locale}><h3>{acceptance.locale==='hi'?acceptance.document.titleHi:acceptance.document.titleEn}</h3><p style="white-space:pre-wrap;overflow-wrap:anywhere">{acceptance.locale==='hi'?acceptance.document.bodyHi:acceptance.document.bodyEn}</p><p><strong>Accepted declaration:</strong> {acceptance.locale==='hi'?acceptance.document.attestationHi:acceptance.document.attestationEn}</p></div>
</details>):<p>Not collected before policy introduction.</p>}
</section>
</EditorLayout>
<style>.id-preview { width:min(100%,454px); height:auto; margin:1rem 0; } .reporter-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem; } dd { margin:0;white-space:pre-wrap;overflow-wrap:anywhere; } dt { font-weight:bold; } </style>
