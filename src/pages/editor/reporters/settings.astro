---
import EditorLayout from '../../../layouts/EditorLayout.astro';
import { reporterSettings, currentTemplate } from '../../../lib/reporters';
import { defaultCardLayout } from '../../../lib/reporter-card';
import { reporterStorageReady } from '../../../lib/reporter-storage';
const s=await reporterSettings();
const template=await currentTemplate();
---
<EditorLayout title="Reporter registration settings" description="Keep applications closed until payment terms, privacy retention and private storage are configured.">
{Astro.url.searchParams.has('error') && <p role="alert">{Astro.url.searchParams.get('error')}</p>}{Astro.url.searchParams.has('saved') && <p role="status">Settings saved.</p>}
<p>Private storage: {reporterStorageReady()?'Configured':'Not configured'}. Email: {process.env.RESEND_API_KEY?'Configured':'Not configured'}.</p>
<section class="admin-section"><h2>Payment and application settings</h2><form class="admin-form" method="post" action="/api/editor/reporters/action/" enctype="multipart/form-data"><input type="hidden" name="action" value="settings"/>
<label><input type="checkbox" name="enabled" checked={s.enabled}/> Open applications</label>
<div class="admin-form-grid"><label>Application fee (INR)<input type="number" name="fee" min="0" max="100000" step="0.01" required value={s.fee}/></label><label>Payment recipient name<input name="payee" required maxlength="200" value={s.payee}/></label>
<label>Payment instructions (English)<textarea name="instructionsEn" maxlength="3000" rows="4">{s.instructionsEn}</textarea></label><label>भुगतान निर्देश (हिंदी)<textarea name="instructionsHi" maxlength="3000" rows="4">{s.instructionsHi}</textarea></label><label>Refund policy (English)<textarea name="refundEn" maxlength="3000" rows="4">{s.refundEn}</textarea></label><label>वापसी नीति (हिंदी)<textarea name="refundHi" maxlength="3000" rows="4">{s.refundHi}</textarea></label>
<label>Evidence retention after final review (days)<input name="evidenceDays" type="number" min="1" max="3650" required value={s.evidenceDays}/></label><label>Profile/photo/card retention after expiry or revocation (days)<input name="profileDays" type="number" min="1" max="3650" required value={s.profileDays}/></label>
<label>Next reporter number<input name="nextNumber" required type="number" min={s.nextNumber || 1} max="999999999" value={s.nextNumber || ''}/></label><label>Replace payment QR image (optional, max 5 MB)<input type="file" name="qr" accept="image/jpeg,image/png,image/webp"/></label></div>
<img src="/api/reporters/qr/" alt="Current payment QR" width="246" height="320" style="object-fit:contain;max-width:100%;height:auto"/>
<label><input name="retentionConfirmed" type="checkbox" checked={s.retentionConfirmed}/> I confirm the retention policy and will schedule daily maintenance.</label><label><input type="checkbox" name="numberConfirmed" required/> I checked existing physical cards; this next number will not conflict.</label><button class="button">Save registration settings</button></form></section>
<section class="admin-section"><h2>Versioned ID-card template</h2><p>The supplied JPEG is the default. Each saved template is a new version. Existing cards never change. All templates use a 908 × 1280 canvas.</p><form class="admin-form" method="post" action="/api/editor/reporters/action/" enctype="multipart/form-data"><input type="hidden" name="action" value="template"/><label>Replacement artwork (optional, max 5 MB)<input name="template" type="file" accept="image/jpeg,image/png,image/webp"/></label><label>Field coordinates, font sizes and colours (JSON)<textarea name="layout" rows="24" required spellcheck="false">{JSON.stringify(template?.layout || defaultCardLayout,null,2)}</textarea></label><label><input name="reviewed" type="checkbox" checked={template?.approved}/> I have reviewed the artwork, signature authorization and field placement for issuance.</label><button class="button">Save new template version</button></form><p>Each candidate still requires a fresh preview before approval. Changing the template invalidates approval of older previews.</p></section>
</EditorLayout>
