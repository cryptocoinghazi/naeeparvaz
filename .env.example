# Safe template only. `./start-local.sh` creates an ignored .env automatically.

ADMIN_EMAIL=editor@naeeparvaz.com
CONTACT_FROM_EMAIL=website@send.naeeparvaz.com
DATABASE_URL=postgresql://naee:local-development-only@127.0.0.1:5432/naee_parvaz
DATABASE_CA_CERT=

# Local browser sign-in code. Use 6-12 digits and never configure it in production.
LOCAL_ADMIN_CODE=

# Required only when testing real Resend delivery locally.
RESEND_API_KEY=

# Generate with `openssl rand -hex 32`. Never reuse the example as a production file.
SESSION_SECRET=

# Cloudflare's published dummy pair; valid only for localhost/testing.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Social Publisher. Leave blank until following docs/social-video-publisher.md.
BUFFER_API_KEY=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_URL_SIGNING_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=naeeparvaz-social-videos-prod
R2_ENDPOINT=
R2_MEDIA_BASE_URL=
