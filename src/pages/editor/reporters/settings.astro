---
import EditorLayout from '../../../layouts/EditorLayout.astro';
import { reporterSettings, currentTemplate } from '../../../lib/reporters';
import { defaultCardLayout } from '../../../lib/reporter-card';
import { reporterStorageReady } from '../../../lib/reporter-storage';
import ReporterPolicySettings from '../../../components/ReporterPolicySettings.astro';
import EditorTabs from '../../../components/EditorTabs.astro';
const s=await reporterSettings();
const template=await currentTemplate();
---
<EditorLayout title="Reporter settings" description="Manage applications, payments and reporter IDs. Complete payment, document storage and privacy settings before accepting applications.">
{Astro.url.searchParams.has('error') && <p role="alert">{Astro.url.searchParams.get('error')}</p>}{Astro.url.searchParams.has('saved') && <p role="status">Settings saved.</p>}
<div class="editor-service-status"><span>Private document storage: {reporterStorageReady()?'Set up':'Needs setup'}</span><span>Email: {process.env.RESEND_API_KEY?'Set up':'Needs setup'}</span></div>
<div data-editor-tabs>
<EditorTabs label="Reporter settings sections" tabs={[{id:'reporter-payment-settings',label:'Applications & payment'},{id:'reporter-card-design',label:'ID card'},{id:'reporter-policy-settings',label:'Reporter policy'}]}/>
<section class="admin-section" id="reporter-payment-settings"><h2>Applications & payment</h2><form class="admin-form" method="post" action="/api/editor/reporters/action/" enctype="multipart/form-data"><input type="hidden" name="action" value="settings"/>
<label><input type="checkbox" name="enabled" checked={s.enabled}/> Accept new applications</label>
<div class="admin-form-grid"><label>Application fee (INR)<input type="number" name="fee" min="0" max="100000" step="0.01" required value={s.fee}/></label><label>Payment recipient name<input name="payee" required maxlength="200" value={s.payee}/></label>
<label>Payment instructions (English)<textarea name="instructionsEn" maxlength="3000" rows="4">{s.instructionsEn}</textarea></label><label>भुगतान निर्देश (हिंदी)<textarea name="instructionsHi" maxlength="3000" rows="4">{s.instructionsHi}</textarea></label><label>Refund policy (English)<textarea name="refundEn" maxlength="3000" rows="4">{s.refundEn}</textarea></label><label>वापसी नीति (हिंदी)<textarea name="refundHi" maxlength="3000" rows="4">{s.refundHi}</textarea></label>
<label>Days to keep submitted documents after the final decision<input name="evidenceDays" type="number" min="1" max="3650" required value={s.evidenceDays}/></label><label>Days to keep the profile, photo and card after expiry or cancellation<input name="profileDays" type="number" min="1" max="3650" required value={s.profileDays}/></label>
<label>Next reporter number<input name="nextNumber" required type="number" min={s.nextNumber || 1} max="999999999" value={s.nextNumber || ''}/></label><label>Replace payment QR image (optional, max 5 MB)<input type="file" name="qr" accept="image/jpeg,image/png,image/webp"/></label></div>
<img src="/api/reporters/qr/" alt="Current payment QR" width="246" height="320" style="object-fit:contain;max-width:100%;height:auto"/>
<label><input name="retentionConfirmed" type="checkbox" checked={s.retentionConfirmed}/> I confirm how long documents are kept and the built-in daily cleanup. I will check its status on the Reporters page.</label><label><input type="checkbox" name="numberConfirmed" required/> I checked existing physical cards; this next number will not conflict.</label><button class="button">Save registration settings</button></form></section>
<section class="admin-section" id="reporter-card-design"><h2>ID-card design</h2><p>The supplied image is used by default. Saving creates a new design version and does not change already issued cards. The design size is 908 × 1280 pixels.</p><form class="admin-form" method="post" action="/api/editor/reporters/action/#reporter-card-design" enctype="multipart/form-data"><input type="hidden" name="action" value="template"/><label>Replace the card artwork (optional, max 5 MB)<input name="template" type="file" accept="image/jpeg,image/png,image/webp"/></label><details class="editor-advanced"><summary>Advanced design settings</summary><p>These values control text positions, sizes and colours. Ask your website administrator for help if you are unsure.</p><label>Design values (JSON)<textarea name="layout" rows="24" required spellcheck="false">{JSON.stringify(template?.layout || defaultCardLayout,null,2)}</textarea></label></details><label><input name="reviewed" type="checkbox" checked={template?.approved}/> I have reviewed the artwork, signature authorization and field placement for issuance.</label><button class="button">Save new design version</button></form><p>Each candidate still requires a fresh preview before approval. Changing the design means previous previews must be reviewed again.</p></section>
<ReporterPolicySettings/>
</div>
</EditorLayout>
