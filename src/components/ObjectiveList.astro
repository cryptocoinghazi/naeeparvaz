---
interface Objective {
  title: string;
  description: string;
}

interface Props {
  objectives: Objective[];
}

const { objectives } = Astro.props;
---

<ol class="objective-list">
  {objectives.map((objective, index) => (
    <li>
      <span class="objective-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
      <div>
        <h3>{objective.title}</h3>
        <p>{objective.description}</p>
      </div>
    </li>
  ))}
</ol>
