{
  "name": "naee-parvaz-news",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "tv:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-tv.ts",
    "reporters:maintenance": "node --env-file-if-exists=.env --import tsx scripts/reporter-maintenance.ts",
    "test:enhancements": "node --import tsx --test tests/enhancements/*.test.ts",
    "test:enhancements:db": "node --env-file=.env --import tsx --test tests/enhancements/database.test.ts",
    "test:enhancements:browser": "node --env-file=.env tests/enhancements/browser.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node ./dist/server/entry.mjs",
    "start": "node scripts/start-production.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "local:credentials": "node scripts/bootstrap-local.mjs",
    "lint": "eslint .",
    "typecheck": "astro check",
    "check": "npm run lint && npm run typecheck",
    "test": "playwright test",
    "media:dev": "wrangler dev --config media-worker/wrangler.jsonc",
    "media:deploy": "wrangler deploy --config media-worker/wrangler.jsonc",
    "test:media-worker": "node --test media-worker/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "astro": "^7.2.4",
    "mp4box": "^2.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.0.0"
  }
}
