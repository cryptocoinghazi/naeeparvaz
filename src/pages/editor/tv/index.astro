---
import EditorLayout from '../../../layouts/EditorLayout.astro';
import { tvSettings } from '../../../lib/tv';
import { getSocialLinks } from '../../../lib/site-repository';
const settings = await tvSettings();
const social = (await getSocialLinks(Astro.locals)).find((s) => s.platform === 'youtube');
---
<EditorLayout title="Naee Parvaz TV" description="Play your public YouTube videos one after another. Your website video library stays separate.">
{Astro.url.searchParams.has('status') && <p role="status">{Astro.url.searchParams.get('status') === 'error' ? 'Unable to complete. Check the channel link or ask your website administrator to check the connection.' : Astro.url.searchParams.get('status') === 'continue' ? 'Progress saved. Select Update video list again to load the remaining videos.' : 'Saved successfully.'}</p>}
<section class="admin-section"><form class="admin-form" method="post" action="/api/editor/tv/"><label>YouTube channel name (@handle) or link<input name="channel" required maxlength="200" value={settings.channel_input || social?.url || social?.identity || ''}/></label><label><input type="checkbox" name="enabled" checked={settings.enabled}/> Enable public TV section</label><button class="button">Save settings</button></form></section>
<section class="admin-section"><h2>YouTube video list</h2><p>Last full update: {settings.synced_at ? new Date(settings.synced_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) : 'Not updated yet'}</p>{settings.last_error && <p role="alert">{settings.last_error}</p>}<form method="post" action="/api/editor/tv/"><input type="hidden" name="action" value="sync"/><button class="button">Update video list</button></form><details class="editor-advanced"><summary>Connection setup help</summary><p>Your website administrator must enable the YouTube Data API and set YOUTUBE_API_KEY on the server. Automatic updates require the documented hourly update command.</p></details></section>
</EditorLayout>
