{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "naee-parvaz-social-media",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "naeeparvaz-social-videos-prod"
    }
  ]
}
