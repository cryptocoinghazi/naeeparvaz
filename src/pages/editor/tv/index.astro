---
import EditorLayout from '../../../layouts/EditorLayout.astro';
import { tvSettings } from '../../../lib/tv';
import { getSocialLinks } from '../../../lib/site-repository';
const settings = await tvSettings();
const social = (await getSocialLinks(Astro.locals)).find((s) => s.platform === 'youtube');
---
<EditorLayout title="Naee Parvaz TV" description="Continuous playback of public, embeddable channel uploads. The existing video library remains separate.">
{Astro.url.searchParams.has('status') && <p role="status">{Astro.url.searchParams.get('status') === 'error' ? 'Unable to complete. Check the channel and server API configuration.' : Astro.url.searchParams.get('status') === 'continue' ? 'Progress saved. Continue synchronization to fetch the remaining pages.' : 'Saved successfully.'}</p>}
<section class="admin-section"><form class="admin-form" method="post" action="/api/editor/tv/"><label>YouTube channel @handle or channel URL<input name="channel" required maxlength="200" value={settings.channel_input || social?.url || social?.identity || ''}/></label><label><input type="checkbox" name="enabled" checked={settings.enabled}/> Enable public TV section</label><button class="button">Save settings</button></form></section>
<section class="admin-section"><h2>Channel synchronization</h2><p>Last complete synchronization: {settings.synced_at ? new Date(settings.synced_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) : 'Not yet synchronized'}</p>{settings.last_error && <p role="alert">{settings.last_error}</p>}<form method="post" action="/api/editor/tv/"><input type="hidden" name="action" value="sync"/><button class="button">Synchronize / continue</button></form><p>Enable the YouTube Data API and configure YOUTUBE_API_KEY server-side. Schedule the documented hourly synchronization command for automatic updates.</p></section>
</EditorLayout>
